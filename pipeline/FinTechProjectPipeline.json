{
	"name": "FinTechProjectPipeline",
	"properties": {
		"activities": [
			{
				"name": "GetTableList",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT \n    TABLE_SCHEMA AS SchemaName,\n    TABLE_NAME AS TableName\nFROM \n    INFORMATION_SCHEMA.TABLES\nWHERE \n    TABLE_TYPE = 'BASE TABLE' and TABLE_SCHEMA = 'fintech'\nORDER BY \n    SchemaName, TableName;",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "New_SQLSourceTables",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "IterateOnEachTable",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "GetTableList",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('GetTableList').output.value",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "SQLDBTofBronzeLayerCopy",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "@concat('SELECT * FROM ',item().SchemaName,'.',item().TableName)",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "New_SQLSourceTables",
									"type": "DatasetReference"
								}
							],
							"outputs": [
								{
									"referenceName": "New_BronzeLayerData",
									"type": "DatasetReference",
									"parameters": {
										"tablename": {
											"value": "@item().TableName",
											"type": "Expression"
										},
										"schemaname": {
											"value": "@item().SchemaName",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "CountRecordsInSourceTable",
							"type": "Lookup",
							"dependsOn": [
								{
									"activity": "SQLDBTofBronzeLayerCopy",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "@concat('select count(*) as src_count from ',item().SchemaName,'.',item().TableName)",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "New_SQLSourceTables",
									"type": "DatasetReference"
								}
							}
						},
						{
							"name": "CountRecordsFromBronzeLayerTable",
							"type": "Script",
							"dependsOn": [
								{
									"activity": "SQLDBTofBronzeLayerCopy",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "SynapseSErverless",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "SELECT COUNT(*) AS tgt_count\nFROM OPENROWSET(\n    BULK 'fintech-raw-data/bronze/@{item().SchemaName}/@{item().TableName}/*.parquet',\n    DATA_SOURCE = 'FintechDataExternal',\n    FORMAT = 'PARQUET'\n) AS rows;\n\n",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						},
						{
							"name": "CheckCount",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "CountRecordsInSourceTable",
									"dependencyConditions": [
										"Succeeded"
									]
								},
								{
									"activity": "CountRecordsFromBronzeLayerTable",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@equals(\n    int(activity('CountRecordsInSourceTable').output.firstRow.src_count), \n    int(activity('CountRecordsFromBronzeLayerTable').output.resultSets[0].rows[0].tgt_count)\n)",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "Fail Pipeline",
										"type": "Fail",
										"dependsOn": [],
										"userProperties": [],
										"typeProperties": {
											"message": "SQL Source table does not match with Bronze layer data",
											"errorCode": "403"
										}
									}
								]
							}
						}
					]
				}
			},
			{
				"name": "BronzeToSilverProcessing",
				"type": "SynapseNotebook",
				"dependsOn": [
					{
						"activity": "IterateOnEachTable",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebook": {
						"referenceName": "BronzeToSilverProcess",
						"type": "NotebookReference"
					},
					"snapshot": true,
					"sparkPool": {
						"referenceName": "sparkpool",
						"type": "BigDataPoolReference"
					},
					"executorSize": "Small",
					"driverSize": "Small"
				}
			},
			{
				"name": "SilverToGoldProcessing",
				"type": "SynapseNotebook",
				"dependsOn": [
					{
						"activity": "BronzeToSilverProcessing",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebook": {
						"referenceName": "SilverToGlodProcess",
						"type": "NotebookReference"
					},
					"snapshot": true,
					"sparkPool": {
						"referenceName": "sparkpool",
						"type": "BigDataPoolReference"
					},
					"executorSize": "Small",
					"driverSize": "Small"
				}
			},
			{
				"name": "SuccessEmail",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "SilverToGoldProcessing",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": "https://prod-15.centralindia.logic.azure.com:443/workflows/a2d4dc6c3a0e4332a2284ee69fbcd9c0/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=RU3yomN__ZsQwbS0CbVo81-gNEl_vq06I5hnPA6iG2o",
					"connectVia": {
						"referenceName": "AutoResolveIntegrationRuntime",
						"type": "IntegrationRuntimeReference"
					},
					"body": {
						"value": "{\n    \"to\": \"@{pipeline().parameters.to}\",\n    \"subject\": \"@{pipeline().parameters.subjectForSuccess}\",\n    \"emailmsg\": \"@{pipeline().parameters.EmailMessageSuccess}\"\n}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "FailureEmail",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "SilverToGoldProcessing",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-type": "application/json"
					},
					"url": "https://prod-15.centralindia.logic.azure.com:443/workflows/a2d4dc6c3a0e4332a2284ee69fbcd9c0/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=RU3yomN__ZsQwbS0CbVo81-gNEl_vq06I5hnPA6iG2o",
					"connectVia": {
						"referenceName": "AutoResolveIntegrationRuntime",
						"type": "IntegrationRuntimeReference"
					},
					"body": {
						"value": "{\n    \"to\": \"@{pipeline().parameters.to}\",\n    \"subject\": \"@{pipeline().parameters.subjectForFailure}\",\n    \"emailmsg\": \"@{pipeline().parameters.EmailMessageFailure}\"\n}",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"to": {
				"type": "string",
				"defaultValue": "ipsitasarkar02@gmail.com"
			},
			"subjectForSuccess": {
				"type": "string",
				"defaultValue": "Fintech DataPipeline Execution  - Success"
			},
			"EmailMessageSuccess": {
				"type": "string",
				"defaultValue": "Today's execution of fintech bdatapipeline is successfull"
			},
			"subjectForFailure": {
				"type": "string",
				"defaultValue": "Fintech DataPipeline Execution  - Failure"
			},
			"EmailMessageFailure": {
				"type": "string",
				"defaultValue": "Today's execution of fintech bdatapipeline is failed"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-08-05T06:56:26Z"
	},
	"type": "Microsoft.Synapse/workspaces/pipelines"
}